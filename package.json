{
  "name": "onit2",
  "version": "1.0.0",
  "description": "hello yaskevich",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "test:unit:ci": "node --import tsx --test --test-reporter=junit --test-reporter-destination=reports/unit.junit.xml --test-reporter=spec --test-reporter-destination=stdout tests/unit/*.test.ts",
    "test:integration:ci": "node --import tsx --test --test-reporter=junit --test-reporter-destination=reports/integration.junit.xml --test-reporter=spec --test-reporter-destination=stdout tests/integration/*.test.ts",
    "test:e2e:ci": "node --import tsx --test --test-reporter=junit --test-reporter-destination=reports/e2e.junit.xml --test-reporter=spec --test-reporter-destination=stdout tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node main.ts",
    "dev": "tsx watch main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemon": "^1.19.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^1.0.0-rc.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
