# Пример .env для учебного стенда.
# Скопируйте в stand/.env (или в ~/onit-stand/.env на стенде) и заполните.
# В CI этот файл НЕ используется для значений — всё подставляется из
# Settings → CI/CD → Variables. Файл нужен как образец и для проверки
# конфигурации в джобе config:check.

# Образ из GitLab Container Registry (замените <логин> и <проект>)
APP_IMAGE=registry.gitlab.com/<логин>/<проект>:latest

# Порт стенда на хост-машине
STAND_APP_PORT=8090

# База данных стенда
POSTGRES_USER=onit
POSTGRES_PASSWORD=смените-этот-пароль
POSTGRES_DB=onit

# Реестр и deploy-токен с правом read_registry
CI_REGISTRY=registry.gitlab.com
CI_REGISTRY_USER=<deploy-token-username>
CI_REGISTRY_PASSWORD=<deploy-token>
